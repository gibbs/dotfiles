# sway config (Wayland). Shares bar, rofi, dunst and conky config with i3.
# Host specific outputs/input live in ~/.config/sway/config.d/ (host-* packages).

set $mod Mod4
set $term kitty
set $menu rofi -config ~/.config/rofi/config

font pango:Iosevka 11
hide_edge_borders both
title_align center
floating_modifier $mod normal
smart_gaps on
default_border pixel 1
default_floating_border pixel 1

### GTK settings (GTK on Wayland reads gsettings, not settings.ini)
exec_always {
    gsettings set org.gnome.desktop.interface gtk-theme 'Arc-Dark'
    gsettings set org.gnome.desktop.interface icon-theme 'Qogir'
    gsettings set org.gnome.desktop.interface font-name 'IBM Plex Sans 11'
    gsettings set org.gnome.desktop.interface document-font-name 'IBM Plex Sans 11'
    gsettings set org.gnome.desktop.interface monospace-font-name 'Iosevka 14'
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
}

### Key bindings
bindsym $mod+Return exec $term
bindsym $mod+Shift+q kill

bindsym $mod+d exec $menu -show drun
bindsym $mod+w exec $menu -show window
bindsym $mod+s exec $menu -show ssh

bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+ntilde focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+ntilde move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+Tab workspace prev
bindsym $mod+Shift+Tab workspace next

bindsym $mod+h split h
bindsym $mod+v split v

bindsym $mod+f fullscreen toggle
bindsym $mod+b bar mode toggle

bindsym $mod+Shift+s layout stacking
bindsym $mod+Shift+w layout tabbed
bindsym $mod+Shift+e layout toggle split

bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

bindsym $mod+Control+Right workspace next
bindsym $mod+Control+Left workspace prev

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Control+1 workspace number 11
bindsym $mod+Control+2 workspace number 12
bindsym $mod+Control+3 workspace number 13
bindsym $mod+Control+4 workspace number 14
bindsym $mod+Control+5 workspace number 15
bindsym $mod+Control+6 workspace number 16
bindsym $mod+Control+7 workspace number 17
bindsym $mod+Control+8 workspace number 18
bindsym $mod+Control+9 workspace number 19
bindsym $mod+Control+0 workspace number 20

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

bindsym $mod+Shift+c reload
bindsym $mod+Shift+z exec swaynag -t warning -m 'Exit sway?' -B 'Yes, exit sway' 'swaymsg exit'

# Lock / idle
bindsym $mod+Shift+x exec swaylock -f --screenshots --effect-blur 7x5 --clock --indicator
exec swayidle -w \
    timeout 300 'swaylock -f --screenshots --effect-blur 7x5 --clock --indicator' \
    timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f --screenshots --effect-blur 7x5 --clock --indicator'

bindsym $mod+t exec --no-startup-id tilda

mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize shrink height 10 px or 10 ppt
    bindsym k resize grow height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt
    bindsym ntilde resize grow width 10 px or 10 ppt
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

### Colours
set $bg-color            #00000075
set $active-bg-color     #0A0A0A75
set $inactive-bg-color   #00000075
set $text-color          #FFFFFF
set $inactive-text-color #777777
set $urgent-bg-color     #e5393550
set $indicator-color     #ff9900

client.focused          $bg-color          $active-bg-color   $text-color          $indicator-color
client.unfocused        $inactive-bg-color $inactive-bg-color $inactive-text-color $indicator-color
client.focused_inactive $inactive-bg-color $inactive-bg-color $inactive-text-color $indicator-color
client.urgent           $urgent-bg-color   $urgent-bg-color   $text-color          $indicator-color

bar {
    modifier none
    status_command i3blocks
    font pango:Iosevka 11
    position top
    height 30
    tray_output *

    colors {
        background $bg-color
        separator #11111150
        focused_workspace  $bg-color          $bg-color          $text-color
        inactive_workspace $inactive-bg-color $inactive-bg-color $inactive-text-color
        urgent_workspace   $urgent-bg-color   $urgent-bg-color   $text-color
    }
}

### Window rules (app_id for Wayland clients, class for XWayland)
for_window [app_id="pavucontrol"] floating enable
for_window [class="Pavucontrol"] floating enable
for_window [class="Tilda"] floating enable
for_window [app_id="org.gnome.Calculator"] floating enable

### Media / hardware keys
bindsym XF86AudioRaiseVolume exec pamixer -i 5 && pkill -RTMIN+10 i3blocks
bindsym XF86AudioLowerVolume exec pamixer -d 5 && pkill -RTMIN+10 i3blocks
bindsym XF86AudioMute exec pamixer -t && pkill -RTMIN+10 i3blocks
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym XF86KbdBrightnessUp exec brightnessctl -d kbd_backlight set 10%+
bindsym XF86KbdBrightnessDown exec brightnessctl -d kbd_backlight set 10%-

bindsym $mod+F9 exec rhythmbox-client --previous
bindsym $mod+F10 exec rhythmbox-client --stop
bindsym $mod+F11 exec rhythmbox-client --play-pause
bindsym $mod+F12 exec rhythmbox-client --next

bindsym $mod+n exec nautilus

# Clipboard history (replaces clipster)
exec wl-paste --watch cliphist store
bindsym $mod+c exec cliphist list | rofi -dmenu | cliphist decode | wl-copy

# Screenshots (replaces gnome-screenshot): full screen to file, area to clipboard
bindsym Print exec grim ~/pics/screenshot-$(date +%Y-%m-%d_%H-%M-%S).png
bindsym $mod+Print exec grim -g "$(slurp)" - | wl-copy

### Wallpaper
output * bg ~/.wallpapers/wallpaper2.jpg fill

### Autostart
exec_always ~/.config/i3/autoname-workspaces.py
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec gnome-keyring-daemon --start --components=secrets
exec dunst
exec conky
exec nm-applet --indicator

# Host specific config (host-* stow packages)
include ~/.config/sway/config.d/*

# Export WAYLAND_DISPLAY etc. to systemd/dbus for portals (screen sharing)
include /etc/sway/config.d/*
